A palindromic number reads the same both ways. The largest palindrome made from the product of two 2-digit numbers is 9009 = 91x99.

Find the largest palindrome made from the product of two 3-digit numbers.


def is_palindrome(n):
    s = str(n)
    return s == s[::-1]

def largest_palindrome_product():
    max_palindrome = 0
    for i in range(999, 99, -1):
        if i * i < max_palindrome:
            break
        for j in range(i, 99, -1):
            product = i * j
            if product <= max_palindrome:
                break
            if is_palindrome(product):
                max_palindrome = product
    return max_palindrome

result = largest_palindrome_product()
print(f"Largest palindrome: {result}")
print(f"Factors: {993} × {913}")   
